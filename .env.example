# LLM Provider: gemini, groq, or ollama (leave keys empty to run in offline
# template mode — the catalog still answers with cited, structured output)
LLM_PROVIDER=gemini

# API Keys (get free keys from respective providers)
GEMINI_API_KEY=your_gemini_key_here
GROQ_API_KEY=your_groq_key_here

# For local Ollama: ollama pull llama3.1:8b
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

# Embedding model
EMBED_MODEL=BAAI/bge-small-en-v1.5

# Database - PostgreSQL (local docker-compose) or SQLite for quick start
# Local: postgresql://substation:substation@localhost:5432/substationiq
# Render: from managed PostgreSQL
# SQLite fallback: sqlite:///./app.db
DATABASE_URL=postgresql://substation:substation@localhost:5432/substationiq

# MongoDB
MONGO_URL=mongodb://localhost:27017
MONGO_DB=substationiq

# Redis (for rate limiting, caching, token deny-list)
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=change-this-in-production-use-strong-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=15            # access token lifetime; refresh token keeps users signed in
REFRESH_EXPIRE_DAYS=7
REFRESH_REUSE_GRACE_SECONDS=10

# Two-factor auth (TOTP). Generate a key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Production refuses to start without it (AUTH_TRD Day 7).
TOTP_ENCRYPTION_KEY=
# Login fails before the second factor: 5 codes, then a 15-minute lock.
MFA_MAX_FAILURES=5
MFA_LOCK_SECONDS=900

# E-mail: console prints mails (incl. verification/reset links) to the server
# log — fine for local dev; use smtp or resend in production.
MAIL_BACKEND=console
APP_BASE_URL=http://localhost:5173   # links in mails point here
# When true, login is blocked until the address is confirmed (needs a real
# MAIL_BACKEND). Leave false for local development.
REQUIRE_EMAIL_VERIFICATION=false

# Google Sign-In: OAuth client id (Google Cloud Console → Credentials).
# The matching public client id goes to the frontend as VITE_GOOGLE_CLIENT_ID.
# Empty disables the /api/auth/google endpoint (501) and hides the button.
GOOGLE_CLIENT_ID=

# ChromaDB (local: ./data/chroma; Docker: /app/data/chroma)
CHROMA_PATH=./data/chroma

# Retrieval
CONFIDENCE_THRESHOLD=0.35
TOP_K_VECTOR=20
TOP_K_BM25=20
TOP_K_RERANK=6

# Upload
MAX_UPLOAD_MB=25

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# CORS allow-list (comma-separated, exact origins only)
CORS_ALLOW_ORIGINS=http://localhost:5173

# CORS origin regex (optional): allows wildcard subdomains (e.g. Vercel previews).
# Example pattern for any Vercel preview URL:
CORS_ALLOW_ORIGIN_REGEX=https://.*\.vercel\.app

# Rate limiting (per client IP) and failed-login lockout (per IP + email)
RATE_LIMIT_LOGIN=30/minute
RATE_LIMIT_REGISTER=30/hour
RATE_LIMIT_CHAT=30/minute
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900

# Environment: 'production' refuses to start with a placeholder JWT_SECRET (<32 chars),
# empty CORS list, or demo users enabled.
APP_ENV=development
# Create demo trainee/engineer/admin accounts on seed (development only!)
SEED_DEMO_USERS=true

# Logging
LOG_LEVEL=INFO