# LLM Provider: gemini, groq, or ollama (leave keys empty to run in offline
# template mode — the catalog still answers with cited, structured output)
LLM_PROVIDER=gemini

# API Keys (get free keys from respective providers)
GEMINI_API_KEY=your_gemini_key_here
GROQ_API_KEY=your_groq_key_here

# For local Ollama: ollama pull llama3.1:8b
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

# Embedding model
EMBED_MODEL=BAAI/bge-small-en-v1.5

# Database
DATABASE_URL=sqlite:///./app.db

# JWT
JWT_SECRET=change-this-in-production-use-strong-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ChromaDB (empty = <repo>/data/chroma; docker-compose mounts ./data at /app/data)
# CHROMA_PATH=

# Retrieval
CONFIDENCE_THRESHOLD=0.35
TOP_K_VECTOR=20
TOP_K_BM25=20
TOP_K_RERANK=6

# Upload
MAX_UPLOAD_MB=25

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Logging
LOG_LEVEL=INFO