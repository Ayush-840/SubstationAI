# LLM Provider: gemini, groq, or ollama (leave keys empty to run in offline
# template mode — the catalog still answers with cited, structured output)
LLM_PROVIDER=gemini

# API Keys (get free keys from respective providers)
GEMINI_API_KEY=your_gemini_key_here
GROQ_API_KEY=your_groq_key_here

# For local Ollama: ollama pull llama3.1:8b
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

# Embedding model
EMBED_MODEL=BAAI/bge-small-en-v1.5

# Database - PostgreSQL (local docker-compose) or SQLite for quick start
# Local: postgresql://substation:substation@localhost:5432/substationiq
# Render: from managed PostgreSQL
# SQLite fallback: sqlite:///./app.db
DATABASE_URL=postgresql://substation:substation@localhost:5432/substationiq

# MongoDB
MONGO_URL=mongodb://localhost:27017
MONGO_DB=substationiq

# Redis (for rate limiting, caching, token deny-list)
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=change-this-in-production-use-strong-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
REFRESH_EXPIRE_DAYS=7

# ChromaDB (local: ./data/chroma; Docker: /app/data/chroma)
CHROMA_PATH=./data/chroma

# Retrieval
CONFIDENCE_THRESHOLD=0.35
TOP_K_VECTOR=20
TOP_K_BM25=20
TOP_K_RERANK=6

# Upload
MAX_UPLOAD_MB=25

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# CORS allow-list (comma-separated, exact origins only)
CORS_ALLOW_ORIGINS=http://localhost:5173

# CORS origin regex (optional): allows wildcard subdomains (e.g. Vercel previews).
# Example pattern for any Vercel preview URL:
CORS_ALLOW_ORIGIN_REGEX=https://.*\.vercel\.app

# Rate limiting
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_CHAT=30/minute

# Logging
LOG_LEVEL=INFO