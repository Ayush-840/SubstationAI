# Test environment. Copy to .env.test and point DATABASE_URL at a throwaway
# database before running `npm test`.
NODE_ENV=test
PORT=4001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/substationiq_test
JWT_SECRET=test-only-jwt-secret-that-is-definitely-longer-than-32-characters
JWT_EXPIRES_IN=1h
FRONTEND_ORIGIN=http://localhost:5173
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@substationiq.dev
ADMIN_PASSWORD=AdminPass123!
