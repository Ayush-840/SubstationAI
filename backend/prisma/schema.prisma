generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  ENGINEER
}

enum DocumentStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

enum MessageRole {
  USER
  ASSISTANT
}

enum XrMode {
  DESKTOP
  VR
  AR
}

// ─────────────────────────────────────────────────────────────────────────────
// Models
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id        String        @id @default(uuid())
  name      String
  email     String        @unique
  password  String
  role      Role          @default(ENGINEER)
  createdAt DateTime      @default(now())
  sessions  ChatSession[]
  trainingSessions TrainingSession[]

  @@map("users")
}

model Equipment {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  tests       Test[]
  arScene     ArScene?

  @@map("equipment")
}

model Test {
  id              String    @id @default(uuid())
  equipment       Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  equipmentId     String
  name            String
  aliases         String[]
  steps           String[]
  limits          String?
  safety          String[]
  tools           String[]
  standard        String?
  troubleshooting String?
  arScript        ArScript?
  trainingSessions TrainingSession[]

  @@map("tests")
}

model Document {
  id            String         @id @default(uuid())
  title         String
  filePath      String
  equipmentType String?
  standard      String?
  status        DocumentStatus @default(PENDING)
  error         String?
  uploadedAt    DateTime       @default(now())
  chunks        DocumentChunk[]

  @@map("documents")
}

model DocumentChunk {
  id            String    @id @default(uuid())
  document      Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId    String
  content       String
  page          Int?
  equipmentType String?
  testName      String?
  standard      String?
  // Person 2 owns this column and its indexes. We just declare it.
  embedding     Unsupported("vector(768)")?

  @@map("document_chunks")
}

model ChatSession {
  id        String    @id @default(uuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  title     String    @default("New Chat")
  createdAt DateTime  @default(now())
  messages  Message[]

  @@map("chat_sessions")
}

model Message {
  id        String      @id @default(uuid())
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  role      MessageRole
  content   String
  sources   Json?
  createdAt DateTime    @default(now())

  @@map("messages")
}


// ─────────────────────────────────────────────────────────────────────────────
// XR Trainer (AR / VR / 3D)
// ─────────────────────────────────────────────────────────────────────────────

model ArScene {
  id          String    @id @default(uuid())
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  equipmentId String    @unique
  modelUrl    String    @default("")
  version     Int       @default(1)
  parts       Json      @default("[]")
  zones       Json      @default("[]")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("ar_scenes")
}

model ArScript {
  id        String   @id @default(uuid())
  test      Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  testId    String   @unique
  limits    Json     @default("{\"r1MinMOhm\":1000,\"piMin\":1.5}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  steps     ArStep[]

  @@map("ar_scripts")
}

model ArStep {
  id       String   @id @default(uuid())
  script   ArScript @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  scriptId String
  stepNo   Int
  type     String
  target   String
  action   String
  value    String?
  text     String

  @@unique([scriptId, stepNo])
  @@map("ar_steps")
}

model TrainingSession {
  id         String    @id @default(uuid())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  test       Test      @relation(fields: [testId], references: [id], onDelete: Cascade)
  testId     String
  mode       XrMode
  startedAt  DateTime
  finishedAt DateTime?
  stepsDone  Int
  stepsTotal Int
  violations Json      @default("[]")
  readings   Json?
  verdict    String?
  score      Int
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([testId])
  @@map("training_sessions")
}
