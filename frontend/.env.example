# Browser API base. Leave empty in local development to use Vite's same-origin proxy.
# Production: set this to your backend origin, such as https://your-backend.onrender.com
VITE_API_URL=

# Local Vite proxy target (matches backend/.env PORT=4000)
VITE_DEV_API_PROXY=http://localhost:4000

# Demo mode (shows demo credentials on login page)
VITE_DEMO_MODE=true

# Google Sign-In: public OAuth client id (same Google Cloud project as the
# backend GOOGLE_CLIENT_ID). Leave empty to hide the Google button.
VITE_GOOGLE_CLIENT_ID=
