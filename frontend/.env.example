# API URL - set to your backend URL
# Local: http://localhost:8000
# Production: https://your-backend.onrender.com
VITE_API_URL=http://localhost:8000

# Demo mode (shows demo credentials on login page)
VITE_DEMO_MODE=true

# Google Sign-In: public OAuth client id (same Google Cloud project as the
# backend GOOGLE_CLIENT_ID). Leave empty to hide the Google button.
VITE_GOOGLE_CLIENT_ID=